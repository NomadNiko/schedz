# The Schedz API (schedz-server), including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Social sign-in is off by default. To enable, set to true and add your own
# client/app id.
NEXT_PUBLIC_IS_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_IS_FACEBOOK_AUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Admins are created from the admin panel; public sign-up is off.
NEXT_PUBLIC_IS_SIGN_UP_ENABLED=false

# Support "local", "s3", "s3-presigned"
NEXT_PUBLIC_FILE_DRIVER=local
